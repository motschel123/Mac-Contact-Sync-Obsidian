{
  "compilerOptions": {
    "paths": {
      "src/*": ["./src/*"]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2020",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES2020",
      "ESNext",
      "ESNext.Disposable"
    ],
    "types": ["node", "jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ]
}